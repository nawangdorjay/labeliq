# SQLite database file used by Prisma.
# NOTE: with SQLite, Prisma resolves relative `file:` paths from prisma/schema.prisma,
# so this example creates the database at prisma/db/custom.db (the standard Prisma
# convention — both the CLI and the runtime client resolve it identically).
# If you prefer another location, use an absolute path, e.g.:
#   DATABASE_URL=file:/home/you/labeliq/db/custom.db
DATABASE_URL="file:./db/custom.db"

# --- AI providers (optional; enable VLM label-extraction fallback) ---
# Z.ai GLM vision (primary). Model glm-4.6v-flash is free-tier resource-pack
# backed; other GLM models need account recharge.
# ZAI_API_KEY=your-zai-api-key
# ZAI_MODEL=glm-4.6v-flash
# NVIDIA NIM (backup, OpenAI-compatible). Get a key at build.nvidia.com.
# NIM_API_KEY=nvapi-xxxxxxxx
# NIM_MODEL=meta/llama-4-scout-17b-16e-instruct

# --- Shared AI key access gate (optional) ---
# Password required to use the SERVER's AI keys when the visitor has no key
# of their own (asked once per browsing session). Falls back to the built-in
# default when unset. Change it to rotate all outstanding session tokens.
# AI_ACCESS_PASSWORD=change-me
